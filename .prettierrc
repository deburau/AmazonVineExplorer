{
    "printWidth": 140,
    "tabWidth": 4,
    "singleQuote": true,
    "semi": true,
    "arrowParens": "always",
    "trailingComma": "none",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.md"],
            "options": {
                "tabWidth": 2,
                "printWidth": 100,
                "proseWrap": "preserve"
            }
        }
    ]
}
